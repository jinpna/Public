!/package.json
!/package-lock.json
!/work/
/work/*
!/work/app/
!/work/build-mopix-css.cjs
!/work/preview.cjs
!/work/package-update.py
!/work/install-mopix.py
!/work/check-ten-tools.cjs
!/work/check-inter-tight.cjs
!/work/check-no-film.cjs
!/work/check-comet.cjs
!/work/check-concept-dark.cjs
!/work/check-quiet-preview.cjs
!/work/check-video-tools.cjs
!/work/check-creation-tools.cjs
!/work/check-premium-workflow.cjs
!/work/check-muse-access.cjs
!/work/check-prompt-engine.cjs
!/work/check-creative-workflow.cjs
!/work/check-busy-workspaces.cjs
!/work/check-upscale-preview.cjs
!/work/check-upscale-history.cjs
!/work/check-workspace-layout.cjs
!/work/mopix.icns
/work/app/vendor
**/node_modules/
**/data/
**/profiles/
**/uploads/
**/videos/
**/.env
**/.env.*
**/*.log
**/*.db
**/*.sqlite*
**/*.asar
**/*.bak*
**/.DS_Store
